# MemVault configuration — copy to .env (everything is optional).
# Out of the box MemVault uses the offline local embedder + rule extractor,
# so no key is required. Fill these in only to enable LLM extraction /
# OpenAI embeddings.

# Extractor: rule (default, offline) | llm (requires an OpenAI key)
MEMVAULT_EXTRACTOR=rule
# Embedder: local (default, offline) | openai
MEMVAULT_EMBEDDER=local

# Any OpenAI Chat/Embeddings-compatible endpoint works (OpenAI, vLLM,
# DeepSeek, one-api/new-api gateways, school compute centers...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Extra JSON merged into every chat/completions request body. Needed for some
# gateways/models, e.g. qwen3 reasoning models prepend a "<think...>" chain
# by default which breaks JSON fact extraction; on new-api/one-api gateways
# disable it under chat_template_kwargs:
#   MEMVAULT_LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
MEMVAULT_LLM_EXTRA_BODY=

# Retrieval blend: score = vector_weight*cosine + keyword_weight*keyword
MEMVAULT_VECTOR_WEIGHT=0.7
MEMVAULT_KEYWORD_WEIGHT=0.3

# Storage / HTTP
MEMVAULT_DB_PATH=data/memvault.db
MEMVAULT_HOST=127.0.0.1
MEMVAULT_PORT=8780

# Default scopes (Sprint 10) — when empty: user=OS user, agent=project slug
MEMVAULT_DEFAULT_USER_ID=
MEMVAULT_DEFAULT_AGENT_ID=
MEMVAULT_DEFAULT_RUN_ID=
MEMVAULT_PROJECT_DIR=
# Disable automatic default scopes (explicit scope still works, values kept)
MEMVAULT_SCOPE_USER_FROM_OS=1
MEMVAULT_SCOPE_AGENT_FROM_PROJECT=1
